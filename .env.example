DATABASE_URL="postgresql://pos:pos@localhost:5433/pos?schema=public"
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL"
UPLOAD_DIR="./uploads"

# Hanya untuk deploy Vercel (lihat docs/deploy/07-vercel-demo.md)
# BLOB_READ_WRITE_TOKEN=   # menyimpan file upload di Vercel Blob (tanpa ini: folder UPLOAD_DIR)
# DATABASE_POOL_MAX=5      # jumlah koneksi per instance serverless
