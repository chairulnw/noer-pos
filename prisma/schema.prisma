generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  DOKTER
  KASIR
}

enum PatientSex {
  JANTAN
  BETINA
}

enum AppointmentStatus {
  TERJADWAL
  SELESAI
  BATAL
}

enum ExaminationType {
  LAB
  RADIOLOGI
}

enum WalletTxType {
  TOPUP
  PAYMENT
  RETURN
  ADJUST
}

enum SurgeryStatus {
  DIJADWALKAN
  BERJALAN
  SELESAI
  BATAL
}

enum GroomingStatus {
  MENUNGGU
  PROSES
  SELESAI
  BATAL
}

enum VisitStatus {
  DILAYANI
  MENUNGGU_BAYAR
  SELESAI
  BATAL
}

enum ItemType {
  SERVICE
  PRODUCT
}

enum BillingUnit {
  PER_ITEM
  PER_DAY
}

enum StockMovementType {
  IN
  OUT
  VOID_RETURN
  ADJUST
}

enum OpnameStatus {
  DRAFT
  FINAL
}

enum RoomType {
  RAWAT_INAP
  HOTEL
}

enum AdmissionType {
  RAWAT_INAP
  HOTEL
}

enum AdmissionStatus {
  AKTIF
  SELESAI
}

enum InvoiceStatus {
  DRAFT
  FINAL
  VOID
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PaymentKind {
  DP
  PELUNASAN
  LUNAS
}

enum PaymentMethod {
  TUNAI
  QRIS
  TRANSFER
  KARTU
  WALLET
}

// ---------- Auth & User ----------

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  passwordHash String  @map("password_hash")
  name         String
  role         Role
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visitsAsDoctor       Visit[]             @relation("VisitDoctor")
  visitsCreated        Visit[]             @relation("VisitCreatedBy")
  recordAddenda        RecordAddendum[]
  stockMovements       StockMovement[]
  stockOpnames         StockOpname[]
  admissionLogs        AdmissionLog[]
  invoicesCreated      Invoice[]           @relation("InvoiceCreatedBy")
  invoicesVoided       Invoice[]           @relation("InvoiceVoidedBy")
  paymentsReceived     Payment[]
  auditLogs            AuditLog[]
  cashClosings         CashClosing[]
  surgeriesAsDoctor    Surgery[]           @relation("SurgeryDoctor")
  surgeriesCreated     Surgery[]           @relation("SurgeryCreatedBy")
  surgeryAddenda       SurgeryAddendum[]
  notificationReads    NotificationRead[]
  operationalCosts     OperationalCost[]
  walletTransactions   WalletTransaction[]
  examinationsCreated  Examination[]
  appointmentsAsDoctor Appointment[]       @relation("AppointmentDoctor")
  appointmentsCreated  Appointment[]       @relation("AppointmentCreatedBy")
  groomings            Grooming[]

  @@map("user")
}

// ---------- Owner & Pasien ----------

model Owner {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  whatsapp      String
  address       String
  notes         String?
  deletedAt     DateTime? @map("deleted_at")
  walletBalance Int       @default(0) @map("wallet_balance")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patients           Patient[]
  invoices           Invoice[]
  walletTransactions WalletTransaction[]

  @@index([whatsapp])
  @@map("owner")
}

model Patient {
  id           String     @id @default(uuid()) @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  rmNo         String     @unique @map("rm_no")
  name         String
  species      String
  breed        String?
  sex          PatientSex
  birthDate    DateTime?  @map("birth_date") @db.Date
  color        String?
  microchip    String?
  neutered     Boolean    @default(false)
  lastWeightKg Decimal?   @map("last_weight_kg") @db.Decimal(6, 2)
  allergyNote  String?    @map("allergy_note")
  aggressive   Boolean    @default(false)
  behaviorNote String?    @map("behavior_note")
  photoPath    String?    @map("photo_path")
  deletedAt    DateTime?  @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        Owner         @relation(fields: [ownerId], references: [id])
  visits       Visit[]
  appointments Appointment[]
  surgeries    Surgery[]
  examinations Examination[]
  admissions   Admission[]
  groomings    Grooming[]

  @@index([microchip])
  @@map("patient")
}

// ---------- Kunjungan ----------

model Visit {
  id          String      @id @default(uuid()) @db.Uuid
  patientId   String      @map("patient_id") @db.Uuid
  doctorId    String      @map("doctor_id") @db.Uuid
  createdById String      @map("created_by") @db.Uuid
  visitDate   DateTime    @map("visit_date") @db.Date
  complaint   String
  status      VisitStatus @default(DILAYANI)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        User           @relation("VisitDoctor", fields: [doctorId], references: [id])
  createdBy     User           @relation("VisitCreatedBy", fields: [createdById], references: [id])
  medicalRecord MedicalRecord?
  invoices      Invoice[]
  admissions    Admission[]
  appointment   Appointment?

  @@index([visitDate, status])
  @@map("visit")
}

// ---------- Rekam Medis ----------

model MedicalRecord {
  id          String    @id @default(uuid()) @db.Uuid
  visitId     String    @unique @map("visit_id") @db.Uuid
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  diagnosis   String?
  vitals      Json?
  finalized   Boolean   @default(false)
  finalizedAt DateTime? @map("finalized_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visit             Visit              @relation(fields: [visitId], references: [id])
  addenda           RecordAddendum[]
  attachments       Attachment[]
  examinations      Examination[]
  prescriptionItems PrescriptionItem[]
  vaccinations      Vaccination[]

  @@map("medical_record")
}

model RecordAddendum {
  id       String @id @default(uuid()) @db.Uuid
  recordId String @map("record_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  note     String

  createdAt DateTime @default(now()) @map("created_at")

  record MedicalRecord @relation(fields: [recordId], references: [id])
  user   User          @relation(fields: [userId], references: [id])

  @@map("record_addendum")
}

model PrescriptionItem {
  id          String  @id @default(uuid()) @db.Uuid
  recordId    String  @map("record_id") @db.Uuid
  itemId      String  @map("item_id") @db.Uuid
  qty         Decimal @db.Decimal(12, 3)
  instruction String?

  record MedicalRecord @relation(fields: [recordId], references: [id])
  item   Item          @relation(fields: [itemId], references: [id])

  @@map("prescription_item")
}

model Vaccination {
  id       String    @id @default(uuid()) @db.Uuid
  recordId String    @map("record_id") @db.Uuid
  itemId   String    @map("item_id") @db.Uuid
  batchNo  String?   @map("batch_no")
  givenAt  DateTime  @map("given_at") @db.Date
  nextDue  DateTime? @map("next_due") @db.Date

  record MedicalRecord @relation(fields: [recordId], references: [id])
  item   Item          @relation(fields: [itemId], references: [id])

  @@map("vaccination")
}

model Attachment {
  id            String  @id @default(uuid()) @db.Uuid
  recordId      String? @map("record_id") @db.Uuid
  examinationId String? @map("examination_id") @db.Uuid
  filePath      String  @map("file_path")
  fileName      String  @map("file_name")
  mime          String
  size          Int

  createdAt DateTime @default(now()) @map("created_at")

  record      MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: Restrict)
  examination Examination?   @relation(fields: [examinationId], references: [id], onDelete: Restrict)

  @@map("attachment")
}

// ---------- Master Layanan & Produk ----------

model Item {
  id                  String      @id @default(uuid()) @db.Uuid
  type                ItemType
  category            String
  sku                 String?     @unique
  barcode             String?     @unique
  name                String
  sellPrice           Int         @map("sell_price")
  buyPrice            Int         @map("buy_price")
  baseUnit            String      @map("base_unit")
  purchaseUnit        String?     @map("purchase_unit")
  conversionFactor    Decimal     @default(1) @map("conversion_factor") @db.Decimal(12, 3)
  lowStockThreshold   Decimal?    @map("low_stock_threshold") @db.Decimal(12, 3)
  trackExpiry         Boolean     @default(false) @map("track_expiry")
  billingUnit         BillingUnit @default(PER_ITEM) @map("billing_unit")
  vaccineIntervalDays Int?        @map("vaccine_interval_days")
  active              Boolean     @default(true)
  deletedAt           DateTime?   @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoiceItems      InvoiceItem[]
  surgeries         Surgery[]
  stockBatches      StockBatch[]
  prescriptionItems PrescriptionItem[]
  vaccinations      Vaccination[]
  admissions        Admission[]
  groomings         Grooming[]
  rooms             Room[]             @relation("RoomDefaultRate")

  @@map("item")
}

// ---------- Inventaris ----------

model StockBatch {
  id              String    @id @default(uuid()) @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  batchNo         String    @map("batch_no")
  expiryDate      DateTime? @map("expiry_date") @db.Date
  qtyOnHand       Decimal   @default(0) @map("qty_on_hand") @db.Decimal(12, 3)
  costPerBaseUnit Int       @map("cost_per_base_unit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item        Item            @relation(fields: [itemId], references: [id])
  movements   StockMovement[]
  opnameItems OpnameItem[]

  @@index([itemId, expiryDate])
  @@map("stock_batch")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  batchId       String            @map("batch_id") @db.Uuid
  type          StockMovementType
  qty           Decimal           @db.Decimal(12, 3)
  refType       String?           @map("ref_type")
  refId         String?           @map("ref_id") @db.Uuid
  invoiceItemId String?           @map("invoice_item_id") @db.Uuid
  note          String?
  userId        String            @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  batch       StockBatch   @relation(fields: [batchId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id])

  @@map("stock_movement")
}

model StockOpname {
  id         String       @id @default(uuid()) @db.Uuid
  opnameDate DateTime     @map("opname_date") @db.Date
  status     OpnameStatus @default(DRAFT)
  userId     String       @map("user_id") @db.Uuid
  note       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id])
  items OpnameItem[]

  @@map("stock_opname")
}

model OpnameItem {
  id         String  @id @default(uuid()) @db.Uuid
  opnameId   String  @map("opname_id") @db.Uuid
  batchId    String  @map("batch_id") @db.Uuid
  systemQty  Decimal @map("system_qty") @db.Decimal(12, 3)
  countedQty Decimal @map("counted_qty") @db.Decimal(12, 3)
  diff       Decimal @db.Decimal(12, 3)
  reason     String?

  opname StockOpname @relation(fields: [opnameId], references: [id])
  batch  StockBatch  @relation(fields: [batchId], references: [id])

  @@map("opname_item")
}

// ---------- Rawat Inap & Pet Hotel ----------

model Room {
  id     String   @id @default(uuid()) @db.Uuid
  name   String
  type   RoomType
  active Boolean  @default(true)

  capacity      Int       @default(1)
  needsCleaning Boolean   @default(false) @map("needs_cleaning")
  defaultRateId String?   @map("default_rate_id") @db.Uuid
  suitableFor   String?   @map("suitable_for")
  dimensions    String?
  deletedAt     DateTime? @map("deleted_at")

  defaultRate Item?       @relation("RoomDefaultRate", fields: [defaultRateId], references: [id])
  admissions  Admission[]

  @@map("room")
}

model Admission {
  id                  String          @id @default(uuid()) @db.Uuid
  patientId           String          @map("patient_id") @db.Uuid
  roomId              String          @map("room_id") @db.Uuid
  visitId             String?         @map("visit_id") @db.Uuid
  rateItemId          String          @map("rate_item_id") @db.Uuid
  type                AdmissionType
  checkIn             DateTime        @map("check_in")
  checkOut            DateTime?       @map("check_out")
  billedDays          Int?            @map("billed_days")
  status              AdmissionStatus @default(AKTIF)
  notes               String?
  expectedCheckOut    DateTime?       @map("expected_check_out") @db.Date
  feedingInstructions String?         @map("feeding_instructions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient  Patient        @relation(fields: [patientId], references: [id])
  room     Room           @relation(fields: [roomId], references: [id])
  visit    Visit?         @relation(fields: [visitId], references: [id])
  rateItem Item           @relation(fields: [rateItemId], references: [id])
  logs     AdmissionLog[]
  invoices Invoice[]

  // BR-17: unique index parsial (room_id WHERE status = AKTIF) ada di migrasi SQL
  @@index([roomId, status])
  @@map("admission")
}

model AdmissionLog {
  id          String   @id @default(uuid()) @db.Uuid
  admissionId String   @map("admission_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  loggedAt    DateTime @map("logged_at")
  tempC       Decimal? @map("temp_c") @db.Decimal(4, 1)
  intake      String?
  note        String?

  admission Admission @relation(fields: [admissionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("admission_log")
}

// ---------- Kasir & Billing ----------

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNo     String        @unique @map("invoice_no")
  visitId       String?       @map("visit_id") @db.Uuid
  admissionId   String?       @map("admission_id") @db.Uuid
  ownerId       String?       @map("owner_id") @db.Uuid
  customerName  String?       @map("customer_name")
  status        InvoiceStatus @default(DRAFT)
  subtotal      Int           @default(0)
  discountType  DiscountType? @map("discount_type")
  discountValue Int           @default(0) @map("discount_value")
  discountTotal Int           @default(0) @map("discount_total")
  taxRate       Int           @default(0) @map("tax_rate")
  taxIncluded   Boolean       @default(false) @map("tax_included")
  receiptPrints Int           @default(0) @map("receipt_prints")
  taxTotal      Int           @default(0) @map("tax_total")
  grandTotal    Int           @default(0) @map("grand_total")
  createdById   String        @map("created_by") @db.Uuid
  finalizedAt   DateTime?     @map("finalized_at")
  voidReason    String?       @map("void_reason")
  voidedById    String?       @map("voided_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visit              Visit?              @relation(fields: [visitId], references: [id])
  admission          Admission?          @relation(fields: [admissionId], references: [id])
  owner              Owner?              @relation(fields: [ownerId], references: [id])
  createdBy          User                @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  voidedBy           User?               @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  items              InvoiceItem[]
  payments           Payment[]
  walletTransactions WalletTransaction[]
  surgery            Surgery?
  grooming           Grooming?

  @@map("invoice")
}

model InvoiceItem {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  itemId            String        @map("item_id") @db.Uuid
  nameSnapshot      String        @map("name_snapshot")
  qty               Decimal       @db.Decimal(12, 3)
  unitPriceSnapshot Int           @map("unit_price_snapshot")
  unitCostSnapshot  Int           @map("unit_cost_snapshot")
  position          Int           @default(0)
  discountType      DiscountType? @map("discount_type")
  discountValue     Int           @default(0) @map("discount_value")
  lineTotal         Int           @map("line_total")

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  item           Item            @relation(fields: [itemId], references: [id])
  stockMovements StockMovement[]

  @@map("invoice_item")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  kind         PaymentKind
  method       PaymentMethod
  amount       Int
  cashReceived Int?          @map("cash_received")
  reference    String?
  voided       Boolean       @default(false)
  receivedById String        @map("received_by") @db.Uuid

  paidAt DateTime @default(now()) @map("paid_at")

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  receivedBy User    @relation(fields: [receivedById], references: [id])

  @@map("payment")
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  doctorId    String            @map("doctor_id") @db.Uuid
  scheduledAt DateTime          @map("scheduled_at")
  purpose     String
  notes       String?
  status      AppointmentStatus @default(TERJADWAL)
  visitId     String?           @unique @map("visit_id") @db.Uuid
  createdById String            @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient   Patient @relation(fields: [patientId], references: [id])
  doctor    User    @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  createdBy User    @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  visit     Visit?  @relation(fields: [visitId], references: [id])

  @@index([scheduledAt])
  @@map("appointment")
}

model Examination {
  id          String          @id @default(uuid()) @db.Uuid
  type        ExaminationType
  patientId   String          @map("patient_id") @db.Uuid
  recordId    String?         @map("record_id") @db.Uuid
  name        String
  performedAt DateTime        @map("performed_at") @db.Date
  findings    String?
  notes       String?
  createdById String          @map("created_by") @db.Uuid
  deletedAt   DateTime?       @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient        @relation(fields: [patientId], references: [id])
  record      MedicalRecord? @relation(fields: [recordId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])
  attachments Attachment[]

  @@index([type, performedAt])
  @@index([patientId])
  @@map("examination")
}

model WalletTransaction {
  id           String         @id @default(uuid()) @db.Uuid
  ownerId      String         @map("owner_id") @db.Uuid
  type         WalletTxType
  amount       Int
  balanceAfter Int            @map("balance_after")
  method       PaymentMethod?
  invoiceId    String?        @map("invoice_id") @db.Uuid
  paymentId    String?        @map("payment_id") @db.Uuid
  note         String?
  createdById  String         @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  owner     Owner    @relation(fields: [ownerId], references: [id])
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([ownerId, createdAt])
  @@index([createdAt])
  @@map("wallet_transaction")
}

model OperationalCost {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  amount      Int
  category    String
  costDate    DateTime  @map("cost_date") @db.Date
  notes       String?
  createdById String    @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([costDate])
  @@map("operational_cost")
}

model AnimalSpecies {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  breeds AnimalBreed[]

  @@map("animal_species")
}

model AnimalBreed {
  id        String   @id @default(uuid()) @db.Uuid
  speciesId String   @map("species_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  species AnimalSpecies @relation(fields: [speciesId], references: [id])

  @@unique([speciesId, name])
  @@map("animal_breed")
}

model NotificationRead {
  userId String   @map("user_id") @db.Uuid
  key    String
  readAt DateTime @default(now()) @map("read_at")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, key])
  @@map("notification_read")
}

model Surgery {
  id            String        @id @default(uuid()) @db.Uuid
  patientId     String        @map("patient_id") @db.Uuid
  doctorId      String        @map("doctor_id") @db.Uuid
  serviceItemId String?       @map("service_item_id") @db.Uuid
  procedure     String
  anesthesia    String?
  surgeryDate   DateTime      @map("surgery_date") @db.Date
  status        SurgeryStatus @default(DIJADWALKAN)
  preNotes      String?       @map("pre_notes")
  postNotes     String?       @map("post_notes")
  finishedAt    DateTime?     @map("finished_at")
  invoiceId     String?       @unique @map("invoice_id") @db.Uuid
  createdById   String        @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient           @relation(fields: [patientId], references: [id])
  doctor      User              @relation("SurgeryDoctor", fields: [doctorId], references: [id])
  createdBy   User              @relation("SurgeryCreatedBy", fields: [createdById], references: [id])
  serviceItem Item?             @relation(fields: [serviceItemId], references: [id])
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id])
  addenda     SurgeryAddendum[]

  @@index([surgeryDate])
  @@map("surgery")
}

model SurgeryAddendum {
  id        String   @id @default(uuid()) @db.Uuid
  surgeryId String   @map("surgery_id") @db.Uuid
  note      String
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  surgery Surgery @relation(fields: [surgeryId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("surgery_addendum")
}

model Grooming {
  id            String         @id @default(uuid()) @db.Uuid
  patientId     String         @map("patient_id") @db.Uuid
  serviceItemId String?        @map("service_item_id") @db.Uuid
  groomingDate  DateTime       @map("grooming_date") @db.Date
  status        GroomingStatus @default(MENUNGGU)
  notes         String?
  finishedAt    DateTime?      @map("finished_at")
  invoiceId     String?        @unique @map("invoice_id") @db.Uuid
  createdById   String         @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient  @relation(fields: [patientId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
  serviceItem Item?    @relation(fields: [serviceItemId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([groomingDate])
  @@map("grooming")
}

model CashClosing {
  id          String   @id @default(uuid()) @db.Uuid
  closingDate DateTime @unique @map("closing_date") @db.Date
  openingCash Int      @map("opening_cash")
  cashSales   Int      @map("cash_sales")
  countedCash Int      @map("counted_cash")
  difference  Int
  note        String?
  closedById  String   @map("closed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  closedBy User @relation(fields: [closedById], references: [id])

  @@map("cash_closing")
}

// ---------- Sistem ----------

model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  action   String
  entity   String
  entityId String @map("entity_id")
  before   Json?
  after    Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

model Settings {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model DiagnosisMaster {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  createdAt DateTime @default(now()) @map("created_at")

  @@map("diagnosis_master")
}
